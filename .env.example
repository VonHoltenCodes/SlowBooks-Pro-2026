# ============================================================================
# Slowbooks Pro 2026 — Environment Variables
# Copy to .env and customize: cp .env.example .env
# ============================================================================

# ============================================================================
# CORE APPLICATION
# ============================================================================

APP_HOST=0.0.0.0
APP_PORT=3001

# Docker only: which host interface the published app port binds to. Defaults
# to 127.0.0.1 so `docker compose up` serves this host only. Set to 0.0.0.0 to
# reach the app from other machines — do that only behind a TLS proxy
# (docs/tls-proxy-setup.md). (Native installs use APP_HOST above instead.)
# APP_BIND=127.0.0.1

# Desktop update notice: on by default. Opening the app lets the backend
# request https://dl.slowbookspro.com/latest.json, which tells that host the
# install's IP address and version. Set to 0 to turn the check off.
# SLOWBOOKS_UPDATE_CHECK=0

# Set APP_DEBUG=true ONLY for local development. In production it disables
# the fail-hard startup checks that protect against accidentally shipping
# without TLS, without an encryption secret, etc.
APP_DEBUG=false

# ============================================================================
# DATABASE
# ============================================================================

# Native Linux install:
# DATABASE_URL=postgresql://bookkeeper:bookkeeper@localhost:5432/bookkeeper?sslmode=require

# Production MUST include ?sslmode=require (or ?sslmode=verify-full with a
# pinned CA). Startup will fail hard otherwise when APP_DEBUG=false.

# Docker install — these are picked up by docker-compose.yml:
POSTGRES_USER=bookkeeper
POSTGRES_PASSWORD=bookkeeper
POSTGRES_DB=bookkeeper

# Docker only: the published Postgres port is bound to 127.0.0.1 by default,
# so this host's dev database (with the default `bookkeeper` password) is not
# exposed on the LAN. POSTGRES_PORT sets the host port. Only set
# POSTGRES_BIND=0.0.0.0 if you must reach Postgres from another machine — and
# then change POSTGRES_PASSWORD to a real secret first.
# POSTGRES_PORT=5433
# POSTGRES_BIND=127.0.0.1

# ============================================================================
# TRANSPORT SECURITY
# ============================================================================

# Leave this unset. It defaults to true in production (APP_DEBUG=false)
# and to false with APP_DEBUG=true, and either default is right:
#   - true: a 307 redirect from plain HTTP to HTTPS at the app layer, the
#     Strict-Transport-Security header (HSTS) and the Secure flag on the
#     session cookie. Behind a TLS-terminating proxy the redirect is a no-op,
#     because the proxy forwards HTTPS (FORWARDED_ALLOW_IPS must name it).
#   - false: plain HTTP, for local development and the single-host
#     `docker compose up`, which sets SLOWBOOKS_PRIVATE_NETWORK=1.
# The app refuses to boot with FORCE_HTTPS=false while APP_DEBUG=false
# unless SLOWBOOKS_PRIVATE_NETWORK=1 (see _run_startup_security_checks).
# A value written here wins over both defaults: FORCE_HTTPS=true with
# APP_DEBUG=true redirected http://localhost:3001 to an https:// address
# nothing answered, for every Docker and source install made from this
# file (2.31.3).
# FORCE_HTTPS=true

# HSTS max-age in seconds. Default 63072000 = 2 years (the preload-list
# minimum). Browsers cache the directive for this long.
HSTS_MAX_AGE=63072000

# ============================================================================
# AUTHENTICATION
# ============================================================================

# Cookie-signing secret. If unset, the app auto-generates one to
# .slowbooks-session.key on first boot. For production, set this yourself
# so re-deploys don't invalidate every active session:
#   openssl rand -hex 32
# SESSION_SECRET_KEY=

# Idle session cap. Sliding window — every authenticated request rolls
# the clock forward. 0 disables the idle check. Default 14400s = 4 hours.
SESSION_IDLE_TIMEOUT_SECONDS=14400

# Rate limiting (login + portal endpoints). Set to 0 only in test
# environments or load-testing.
RATE_LIMIT_ENABLED=1

# Reverse-proxy client-IP trust. REQUIRED if anything terminates TLS in front
# of the app (nginx, Traefik, Caddy, an ALB, an ingress controller).
# uvicorn parses X-Forwarded-For but trusts it only from the addresses listed
# here — default 127.0.0.1, which a proxy in another container or pod is not.
# Leave it unset behind a proxy and every request looks like it came from the
# proxy: the login rate limiter degrades into one shared bucket for all users,
# and login_attempts / portal_accesses record the proxy's address instead of
# the caller's. Set to the proxy's address or CIDR. Never 0.0.0.0/0 or * —
# that lets any client forge its own source IP. Leave unset for a direct
# (non-proxied) or desktop install.
# FORWARDED_ALLOW_IPS=172.18.0.0/16

# Shared storage for rate-limit counters. Unset means in-process counters,
# which are per-worker and per-replica: with APP_WORKERS=4 a "5 per minute"
# limit is really 20 per minute, and more across replicas. Required for any
# multi-worker or multi-replica deploy; the in-memory default is correct only
# for a single worker (and the desktop app). The redis client ships with the
# app, and startup refuses to boot when the storage set here is unreachable.
# RATE_LIMIT_STORAGE_URI=redis://redis:6379/0

# Browser origins allowed to call the API. Leave unset to default to
# loopback only. For a separate UI host:
#   CORS_ALLOW_ORIGINS=https://app.example.com
CORS_ALLOW_ORIGINS=

# ============================================================================
# AT-REST ENCRYPTION
# ============================================================================

# Symmetric key used to encrypt employee bank routing/account numbers and
# other PII at rest (Fernet, PBKDF2-SHA256 480k iterations).
#
# Generate a strong value:
#   openssl rand -base64 32
#
# The app refuses to start against PostgreSQL, or in production, with the
# dev default or an empty value, and on every install one typed shorter
# than 16 characters (2.31.3).
PAYROLL_ENCRYPTION_SECRET=

# OPTIONAL: previous secret, used during key rotation. The app decrypts
# legacy ciphertext with PREV when current fails. Rotate via:
#   1. Move the current value into PAYROLL_ENCRYPTION_SECRET_PREV
#   2. Set a new PAYROLL_ENCRYPTION_SECRET
#   3. Bounce the app
#   4. Run the rewrap migration (see docs/security-hardening.md)
#   5. Drop PAYROLL_ENCRYPTION_SECRET_PREV
# PAYROLL_ENCRYPTION_SECRET_PREV=

# OPTIONAL: the key for an encrypted company file (Settings -> Company File
# Encryption, #290). Set it where SlowBooks Pro starts, the same way as
# PAYROLL_ENCRYPTION_SECRET, before turning encryption on; from then on the
# app opens the file only with it, and so do its backups. A different
# secret from the payroll one is fine, and so is the same: the two keys are
# derived under different salts. Generate with:
#   openssl rand -base64 32
# Server Edition: the operator sets this. PostgreSQL deployments do not
# use it -- encryption at rest there is the database host's job.
COMPANY_FILE_ENCRYPTION_SECRET=

# OPTIONAL: key for saved passwords and API keys (SMTP, payment providers,
# QuickBooks Online, the bank feed). Left empty, the app uses its
# .slowbooks-master.key file if there is one, else derives a key from
# PAYROLL_ENCRYPTION_SECRET (so a Docker container can be recreated).
# Docker, upgrading from 2.17 or earlier with saved passwords: copy the old
# key out of the running container first and set it here, or enter those
# passwords again after the upgrade:
#   docker compose exec slowbooks cat /app/.slowbooks-master.key
# SETTINGS_ENCRYPTION_KEY=

# ============================================================================
# COMPANY INFO (optional — also settable from the UI after first login)
# ============================================================================

COMPANY_NAME=My Company
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
DEFAULT_TERMS=Net 30
DEFAULT_TAX_RATE=0.0

# ============================================================================
# EMPLOYER PAYROLL IDENTIFIERS (used by tax forms)
# ============================================================================

# Employer EIN (XX-XXXXXXX). Required for W-2/W-3/940/941 generation.
EMPLOYER_EIN=

# Two-letter state code for the employer's primary location. Drives the
# default state-tax engine.
EMPLOYER_STATE=WA

# State unemployment tax (SUTA) experience rate as a decimal. WA average
# is around 1.2% — verify with your state agency.
SUTA_RATE=0.012
